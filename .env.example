# Copy to .env.local for development. Never commit .env.local.

# Canonical site origin. Used for metadata, Open Graph images and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engine indexing. Defaults to off everywhere, including production.
# Set to "true" only on the live deployment, and only once the content is real
# — an indexed placeholder is what people would find when searching your name,
# and it lingers long after the page is fixed. Never set this on previews.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Contact form (Milestone 11) -------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_ — that would ship the key to the
# browser where anyone could read it out of the bundle.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
